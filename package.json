{
  "name": "haul",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @haul/db exec prisma generate",
    "db:migrate": "pnpm --filter @haul/db exec prisma migrate dev",
    "eval": "pnpm --filter @haul/eval eval",
    "eval:holdout": "pnpm --filter @haul/eval eval:holdout",
    "demo": "pnpm --parallel --filter @haul/api --filter @haul/web run demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
